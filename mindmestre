def cmd_instale(args):
    if sys.platform.startswith("win"):
        print("No Windows use o PowerShell:  powershell -ExecutionPolicy Bypass -File install.ps1")
        return 1
    destino = _destino()
    if os.path.exists(destino):
        shutil.rmtree(destino)
    shutil.copytree(RAIZ, destino, ignore=shutil.ignore_patterns("__pycache__", "saida", "testes", ".git"))
    bin_dir = os.path.expanduser("~/.local/bin")
    os.makedirs(bin_dir, exist_ok=True)
    wrapper = os.path.join(bin_dir, "mindmestre")
    with open(wrapper, "w", encoding="utf-8", newline="") as f:
        f.write("#!/bin/sh\nexport PYTHONUTF8=1\nexport PYTHONIOENCODING=utf-8\nexec python3 \"%s/mindmestre\" \"$@\"\n" % destino)
    os.chmod(wrapper, 0o755)
    print(ag("✓ Mind Mestre instalado em %s (comando global: mindmestre)" % destino, "verde"))
    if bin_dir not in os.environ.get("PATH", "").split(os.pathsep):
        print(ag("avise: adicione %s ao PATH  →  export PATH=\"%s:$PATH\"" % (bin_dir, bin_dir), "amarelo"))
    return 0


def cmd_desinstale(args):
    wrapper = os.path.expanduser("~/.local/bin/mindmestre")
    destino = _destino()
    removidos = []
    if os.path.exists(wrapper):
        os.remove(wrapper)
        removidos.append(wrapper)
    if os.path.exists(destino):
        shutil.rmtree(destino)
        removidos.append(destino)
    print(ag("✓ desinstalado: %s" % (", ".join(removidos) or "nada (já estava limpo)"), "verde"))
    return 0


