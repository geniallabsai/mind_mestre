    for l in bloco():
        print(ag(l, "ciano"))
    return 0


def cmd_versao(args):
    print(__version__)
    return 0


MENU = """Comandos:
  mindmestre                      ← banner + este menu
  mindmestre mapa ALVO [--json]   ← lê o material e para no mapa (mapa.json + mapa.mmd)
  mindmestre plano ALVO [-o DIR]  ← investigação completa → PDF+DOCX+MD+Obsidian+MMD+JSON
  mindmestre conversa [ALVO]      ← interrogatório socrático calibrado pela sua nuance
  mindmestre debate TEMA… [--alvo]← Cético × Convicto × Juiz ao vivo
  mindmestre status               ← equipe + motor de IA
  mindmestre instale / desinstale / arte / versao"""


def main(argv=None):
    ap = argparse.ArgumentParser(prog="mindmestre", description="Mind Mestre — Genial Labs")
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("mapa", help="mapeia o material da pessoa")
    p.add_argument("alvo")
    p.add_argument("-o", help="diretório de saída")
    p.add_argument("--json", action="store_true")
    p = sub.add_parser("plano", help="investigação completa + plano estruturado")
    p.add_argument("alvo")
    p.add_argument("-o", help="diretório de saída")
    p.add_argument("--sem-ia", action="store_true")
    p = sub.add_parser("conversa", help="interrogatório socrático")
    p.add_argument("alvo", nargs="?")
    p.add_argument("-o", help="diretório de saída")
    p.add_argument("--rodadas", type=int, default=5)
    p.add_argument("--tema", default=None)
    p = sub.add_parser("debate", help="Cético × Convicto × Juiz")
    p.add_argument("tema", nargs="*")
    p.add_argument("--alvo", default=None)
    for nome in ("status", "instale", "desinstale", "arte", "versao"):
        sub.add_parser(nome)
    args = ap.parse_args(argv)
    comandos = {"mapa": cmd_mapa, "plano": cmd_plano, "conversa": cmd_conversa,
                "debate": cmd_debate, "status": cmd_status, "instale": cmd_instale,
                "desinstale": cmd_desinstale, "arte": cmd_arte, "versao": cmd_versao}
    if args.cmd is None:
        banner()
        print(MENU)
        return 0
    return comandos[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
