                     Juiz, Posicionador)

CINZA, BRANCO, CIANO, VERDE, VERMELHO, AMARELO = "90", "97", "96", "92", "91", "93"
_CORES = {"cinza": CINZA, "branco": BRANCO, "ciano": CIANO, "verde": VERDE,
          "vermelho": VERMELHO, "amarelo": AMARELO}


def ag(texto, cor="branco"):
    return "\033[%sm%s\033[0m" % (_CORES.get(cor, BRANCO), texto)


def banner():
    for l in bloco():
        print(ag(l, "ciano"))
    print(ag("  Genial Labs · MIND MESTRE  v%s" % __version__, "branco"))
    print("  Pergunta. Hipótese. Evidência. Plano. — destrava vidas profissionais travadas.\n")


class Progresso:
    def __init__(self, rotulo):
        self.rotulo = rotulo
        self.ativa = False

    def __call__(self, etapa, i, total):
        frac = int(30 * i / max(1, total))
        nova = "  %s [%s] %d/%d" % (self.rotulo, "█" * frac + "░" * (30 - frac), i, total)
        if not self.ativa:
            print(nova.ljust(78))
            self.ativa = True
        else:
            sys.stdout.write("\r" + nova.ljust(78))
            sys.stdout.flush()

    def fim(self):
        if self.ativa:
            sys.stdout.write("\r" + " " * 78 + "\n")


def slug_de(nome):
    return re.sub(r"[^a-z0-9]+", "-", (nome or "alvo").lower()).strip("-") or "alvo"


def saida_padrao(slug):
    return os.path.join("saida", slug + "-" + datetime.now().strftime("%Y%m%d-%H%M%S"))


def _destino():
    return os.path.expanduser("~/.genial-mind-mestre")


TEMA_DE_HIPOTESE = {"exposicao": "exposicao", "tempo": "tempo", "oferta": "oferta",
                    "valor": "valor", "prova": "prova", "foco": "foco"}


def cmd_mapa(args):
    banner()
    P = Progresso("Cartógrafo — destrinchando o material")
    mapa = Cartografo().destrinchar(args.alvo, P)
    P.fim()
    base = args.o or saida_padrao(slug_de(mapa.get("nome")))
    os.makedirs(base, exist_ok=True)
    with open(os.path.join(base, "mapa.json"), "w", encoding="utf-8", newline="") as f:
        json.dump(mapa, f, ensure_ascii=False, indent=2)
    with open(os.path.join(base, "mapa.mmd"), "w", encoding="utf-8", newline="") as f:
        f.write(mermaid.mapa_mermaid(mapa) + "\n")
    cont = {}
    for s in mapa.get("sinais", []):
        cont[s["tipo"]] = cont.get(s["tipo"], 0) + 1
    print(ag("✓ Mapa pronto em %s" % base, "verde"))
    print("  persona: %s · %d arquivos · %d palavras" % (
        mapa.get("persona_nome") or "?", mapa["arquivos_total"], mapa["palavras"]))
    print("  sinais: " + (", ".join("%s×%d" % kv for kv in sorted(cont.items())) or "—"))
    print("  ativos: %d · produtos: %s" % (
        len(mapa.get("ativos", [])), ", ".join(mapa.get("produtos_mentionados", [])) or "—"))
    if mapa.get("objetivo_declarado"):
        print("  objetivo: %s" % mapa["objetivo_declarado"][:100])
    if args.json:
        print(json.dumps(mapa, ensure_ascii=False, indent=2))
    return 0


def cmd_plano(args):
    if args.sem_ia:
        os.environ["MIND_SEM_IA"] = "1"
    banner()
    P = Progresso("1/9 Cartógrafo — mapeando a vida profissional")
    mapa = Cartografo().destrinchar(args.alvo, P)
    P.fim()
    P = Progresso("2/9 Detetive — formando e testando hipóteses")
    det = Detetive().investigar(mapa, P)
    P.fim()
    P = Progresso("3/9 Tribunal — Cético × Convicto × Juiz")
    obj = Cetico().objetar(mapa, det)
    defs = Convicto().defender(mapa, det)
    juizo = Juiz().decidir(mapa, det, obj, defs)
    P("pontuando", 1, 1)
    P.fim()
    P = Progresso("4/9 Gênio do Marketing — nicho, persona, empatia")
    mkt = GenioMarketing().estudar(mapa, P)
    P.fim()
    P = Progresso("5/9 Posicionador — território da marca")
    pos = Posicionador().posicionar(mapa, mkt, P)
    P.fim()
    P = Progresso("6/9 Copista — oferta irresistível (corpus 20+ anos)")
    oferta = Copista().escrever(mapa, mkt, pos, det, P)
    P.fim()
    P = Progresso("7/9 Conteudista — máquina de conteúdo viral")
    ct = Conteudista().montar(mapa, mkt, P)
    P.fim()
    P = Progresso("8/9 Estrategista — montando as 6 fases")
    plano = Estrategista().estruturar({"mapa": mapa, "det": det, "mkt": mkt, "pos": pos,
                                        "oferta": oferta, "ct": ct, "juizo": juizo}, P)
    P.fim()
    P = Progresso("9/9 Publicando os artefatos")
    base = args.o or saida_padrao(slug_de(mapa.get("nome")))
    caminhos = relatorios.escrever_tudo(base, plano, mapa)
    P.fim()
    s = plano["selo_juiz"]
    print(ag("\n✓ Plano pronto em %s" % base, "verde"))
    print("  selo do juiz: %s  %d/100 — %s" % (s["barra"], s["confianca"], s["decisao"]))
    for k in ("pdf", "docx", "md", "mapa_json", "mmd_mapa", "mmd_plano", "obsidian"):
        print("  %-10s %s" % (k + ":", os.path.basename(caminhos[k])))
    print(ag("\nSe você é outro agente: leia %s (e mapa.json para evidência)." % caminhos["md"], "amarelo"))
    print(ag("Primeiro prompt sugerido:\n  %s" % plano["prompts"][0], "amarelo"))
    return 0


def cmd_conversa(args):
    banner()
    mapa = None
    if args.alvo:
        P = Progresso("Cartógrafo — mapeando o material")
        mapa = Cartografo().destrinchar(args.alvo, P)
        P.fim()
        det = Detetive().investigar(mapa)
        tema = args.tema or TEMA_DE_HIPOTESE.get(det.get("principal", ""), "abertura")
    else:
        tema = args.tema or "abertura"
    inq = Inquisidor()
    estado = inq.estado_inicial(mapa, tema)
    pares = []
    for _ in range(max(1, args.rodadas)):
        q = inq.pergunta(estado)
        print(ag("Inquisidor:", "ciano") + " " + q)
        try:
            r = input(ag("você: ", "branco")).strip()
        except EOFError:
            break
        if not r or r.lower() in ("fim", "sair", "fim.", "ok"):
            break
        inq.responder(estado, r)
        pares.append((q, r))
    base = args.o or os.path.join("saida", "conversa-" + datetime.now().strftime("%Y%m%d-%H%M%S"))
    os.makedirs(base, exist_ok=True)
    res = inq.fechar(estado)
    L = ["# Conversa com o Inquisidor", "",
         "Tema inicial: %s · respostas: %d · nível final: %d" % (tema, len(pares), estado["nivel"]), ""]
    for q, r in pares:
        L += ["**Pergunta:** %s" % q, "", "Resposta: %s" % r, ""]
    L += ["---", "", "Resumo da nuance: " + json.dumps(res, ensure_ascii=False)]
    cam = os.path.join(base, "conversa.md")
    with open(cam, "w", encoding="utf-8", newline="") as f:
        f.write("\n".join(L))
    print(ag("\n✓ Transcrição salva em %s" % cam, "verde"))
    alvo = args.alvo or "<seu-diretorio-de-notas>"
    print(ag("Sugestão: rode  mindmestre plano %s  para transformar tudo em plano estruturado." % alvo, "amarelo"))
    return 0


def cmd_debate(args):
    tema = " ".join(args.tema)
    banner()
    if args.alvo:
        P = Progresso("Cartógrafo — mapeando o material")
        mapa = Cartografo().destrinchar(args.alvo, P)
        P.fim()
        det = Detetive().investigar(mapa)
        src = args.alvo
    else:
        mapa = {"nome": "debate", "persona_nome": None, "origem": "-", "arquivos_total": 0, "palavras": 0,
                "secoes": [], "sinais": [], "ativos": [], "produtos_mentionados": [],
                "objetivo_declarado": None, "quero_produto": False, "numeros": [],
                "resumo": tema[:120]}
        det = Detetive().investigar(mapa)
        src = "tema livre"
    if tema:
        print(ag("Tema: %s" % tema, "branco") + ag("  (fonte: %s)" % src, "cinza"))
    obj = Cetico().objetar(mapa, det)
    defs = Convicto().defender(mapa, det)
    juizo = Juiz().decidir(mapa, det, obj, defs)
    print()
    for o in obj:
        print(ag("Cético:", "vermelho") + " [%s] %s" % (o["nivel"], o["texto"]))
        print(ag("   ↑ %s" % o.get("evidencia", ""), "cinza"))
    for d in defs:
        print(ag("Convicto:", "verde") + " %s" % d["texto"])
        print(ag("   ↑ %s" % d.get("evidencia", ""), "cinza"))
    print()
    print(ag("Juiz:", "ciano") + " " + ag(juizo["barra"], "branco"))
    print(ag("     confiança %d/100 — %s" % (juizo["confianca"], juizo["decisao"]), "ciano"))
    return 0


